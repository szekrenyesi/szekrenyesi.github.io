---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { t, localizedPath, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  title: string;
  lang: Lang;
  description?: string;
  ogImage?: string;
}

const { title, lang, description, ogImage } = Astro.props;
const fullTitle = `${title} · ${lang === 'hu' ? profile.name : profile.nameEn}`;
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();

// Absolute URL for the current page (canonical + og:url)
const canonical = new URL(currentPath, Astro.site).toString();

// hreflang alternates: strip /en prefix, then build both locales
const stripped =
  lang === 'en'
    ? currentPath.replace(/^\/en/, '') || '/'
    : currentPath;
const huUrl = new URL(localizedPath('hu', stripped), Astro.site).toString();
const enUrl = new URL(localizedPath('en', stripped), Astro.site).toString();

const ogLocale = lang === 'hu' ? 'hu_HU' : 'en_US';
const ogAlt = lang === 'hu' ? 'en_US' : 'hu_HU';
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Canonical + language alternates -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="hu" href={huUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={huUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={lang === 'hu' ? profile.name : profile.nameEn} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAlt} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@400;600;700&family=PT+Serif:ital,wght@0,400;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <Header lang={lang} currentPath={currentPath} />
    <div class="page">
      <Sidebar lang={lang} />
      <main class="content">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <div class="inner">
        <span>© {year} {t(lang, 'footer.copyright')}</span>
        <span>
          <a href={localizedPath(lang, '/imprint')}>{t(lang, 'footer.imprint')}</a>
          &nbsp;·&nbsp;
          <a href={profile.mtmt}>MTMT</a>
          &nbsp;·&nbsp;
          <a href={profile.github}>GitHub</a>
        </span>
      </div>
    </footer>
  </body>
</html>
