---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
import { services } from '../data/services';
const lang = 'hu' as const;
---

<BaseLayout title={t(lang, 'services.title')} lang={lang} description={t(lang, 'desc.services')}>
  <h1>{t(lang, 'services.title')}</h1>
  <p class="lead">Szakmai szolgáltatások egyéni <a href="/imprint">vállalkozásom</a> keretében.</p>

  {services.map((s) => (
    <div class="service">
      <h3>{s.title[lang]}</h3>
      <p>{s.description[lang]}</p>
    </div>
  ))}
</BaseLayout>
