---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/ui';
import { profile } from '../../data/profile';
const lang = 'en' as const;
---

<BaseLayout title={t(lang, 'contact.title')} lang={lang}>
  <h1>{t(lang, 'contact.title')}</h1>

  <p><strong>{t(lang, 'contact.email')}:</strong> <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
  <p><strong>{t(lang, 'contact.affiliation')}:</strong> {profile.affiliation[lang]}</p>
  <p><strong>{t(lang, 'contact.position')}:</strong> {profile.position[lang]}</p>

  <h2>Online profiles</h2>
  <ul>
    <li><a href={profile.mtmt}>{t(lang, 'contact.mtmt')}</a></li>
    <li><a href={profile.github}>{t(lang, 'contact.github')}</a></li>
  </ul>
</BaseLayout>
