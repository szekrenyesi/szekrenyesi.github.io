---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/ui';
import { profile } from '../../data/profile';
const lang = 'en' as const;
const a = profile.academic;
const b = profile.business;
---

<BaseLayout title={t(lang, 'contact.title')} lang={lang} description={t(lang, 'desc.contact')}>
  <h1>{t(lang, 'contact.title')}</h1>

  <h2>{t(lang, 'contact.workplace')}</h2>
  <dl class="imprint">
    <dt>{t(lang, 'contact.affiliation')}</dt>
    <dd>{profile.affiliation[lang]}</dd>
    <dt>{t(lang, 'contact.position')}</dt>
    <dd>{profile.position[lang]}</dd>
    <dt>{t(lang, 'contact.email')}</dt>
    <dd><a href={`mailto:${a.email}`}>{a.email}</a></dd>
    <dt>{t(lang, 'contact.phone')}</dt>
    <dd><a href={`tel:${a.phoneTel}`}>{a.phone}</a></dd>
  </dl>

  <h2>{t(lang, 'contact.business')}</h2>
  <dl class="imprint">
    <dt>{t(lang, 'contact.email')}</dt>
    <dd><a href={`mailto:${b.email}`}>{b.email}</a></dd>
    <dt>{t(lang, 'contact.phone')}</dt>
    <dd><a href={`tel:${b.phoneTel}`}>{b.phone}</a></dd>
  </dl>

  <h2>Online profiles</h2>
  <ul>
    <li><a href={profile.mtmt}>{t(lang, 'contact.mtmt')}</a></li>
    <li><a href={profile.github}>{t(lang, 'contact.github')}</a></li>
  </ul>
</BaseLayout>
