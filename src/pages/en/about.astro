---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/ui';
import { profile } from '../../data/profile';
const lang = 'en' as const;
---

<BaseLayout title={t(lang, 'about.title')} lang={lang}>
  <h1>{t(lang, 'about.title')}</h1>
  <p class="lead">I am Assistant Professor at the Institute of Philosophy, University of Debrecen; I teach logic, philosophy of language, philosophy of science, and other related subjects. Alongside my teaching, I also work in computational linguistics and digital humanities — primarily in speech technology and handwritten text recognition.</p>

  <h2>Education</h2>
  <ul>
    <li>2020 – PhD, University of Debrecen, Doctoral School of Linguistics (Computational Linguistics Subprogramme)</li>
    <li>2010 – MA in Philosophy and Theoretical Linguistics, University of Debrecen</li>
  </ul>

  <h2>PhD dissertation</h2>
  <p><em>Machine processing and application of prosodic features in the analysis of spoken language corpora.</em> Supervisor: Prof. Dr. László Hunyadi.</p>

  <h2>Current and previous positions</h2>
  <ul>
    <li>2023– Assistant Professor, University of Debrecen, Institute of Philosophy</li>
    <li>2022–2026 Junior Research Fellow, Eötvös Loránd University, Department of Digital Humanities</li>
    <li>2018–2023 Assistant Lecturer, University of Debrecen, Institute of Philosophy</li>
    <li>2017–2022 Software Developer and Speech Technology Expert, MindSpeak Ltd.</li>
    <li>2014–2018 Assistant Lecturer, University of Debrecen, Department of General and Applied Linguistics</li>
    <li>2010–2014 Research Assistant, University of Debrecen, Department of General and Applied Linguistics</li>
  </ul>

  <p><a href={profile.cvUrl}>Full CV (PDF) ↓</a></p>
</BaseLayout>
